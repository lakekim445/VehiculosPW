@model IEnumerable<VehiculosMVC.Models.Mantenimiento>

@{
    ViewData["Title"] = "Historial de Mantenimientos";
}

<h1>Historial de Mantenimientos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Mantenimiento</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Vehículo</th>
            <th>Fecha</th>
            <th>Tipo Servicio</th>
            <th>Descripción</th>
            <th>Costo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Vehiculo?.Placa - @item.Vehiculo?.Marca</td>
                <td>@item.Fecha.ToShortDateString()</td>
                <td>@item.TipoServicio</td>
                <td>@item.Descripción</td>
                <td>@item.Costo.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>