@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mt-5">
    <h1 class="display-4"> Sistema de Vehículos y Mantenimientos</h1>
    <p class="lead">Selecciona una opción para comenzar</p>
    <hr class="my-4" />
</div>

<div class="row justify-content-center mt-5">

    <!-- Tarjeta: Vehículos -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-lg h-100 border-primary">
            <div class="card-body text-center">
                <div style="font-size: 4rem;"></div>
                <h3 class="card-title mt-3">Vehículos</h3>
                <p class="card-text text-muted">
                    Administra la flota de vehículos: registra, consulta, edita y elimina.
                </p>
                <a asp-controller="VehiculosMvc" asp-action="Index"
                   class="btn btn-primary btn-lg mt-3 w-100">
                    Ir a Vehículos →
                </a>
            </div>
        </div>
    </div>

    <!-- Tarjeta: Mantenimientos -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-lg h-100 border-success">
            <div class="card-body text-center">
                <div style="font-size: 4rem;"></div>
                <h3 class="card-title mt-3">Mantenimientos</h3>
                <p class="card-text text-muted">
                    Consulta el historial de mantenimientos y registra nuevos servicios.
                </p>
                <a asp-controller="MantenimientosMvc" asp-action="Index"
                   class="btn btn-success btn-lg mt-3 w-100">
                    Ir a Mantenimientos →
                </a>
            </div>
        </div>
    </div>

</div>

<!-- Enlaces secundarios -->
<div class="text-center mt-4">
    <a href="/swagger" target="_blank" class="btn btn-outline-secondary btn-sm">
        Ver documentación Swagger (API REST)
    </a>
</div>