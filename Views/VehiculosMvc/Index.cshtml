@model IEnumerable<VehiculosMVC.Models.Vehiculo>

@{
    ViewData["Title"] = "Lista de Vehículos";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 gap-2">
    <h1 class="h3 mb-0">Lista de Vehículos</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nuevo Vehículo
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Placa</th>
                        <th>Marca</th>
                        <th class="d-none d-md-table-cell">Modelo</th>
                        <th class="d-none d-lg-table-cell">Año</th>
                        <th class="d-none d-md-table-cell">Tipo</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">@item.Placa</td>
                            <td>@item.Marca</td>
                            <td class="d-none d-md-table-cell">@item.Modelo</td>
                            <td class="d-none d-lg-table-cell">@item.Año</td>
                            <td class="d-none d-md-table-cell">@item.Tipo</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm" title="Ver">
                                    <i class="bi bi-eye"></i>
                                    <span class="d-none d-lg-inline">Ver</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                    <span class="d-none d-lg-inline">Editar</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                    <span class="d-none d-lg-inline">Eliminar</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>