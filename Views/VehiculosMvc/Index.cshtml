@model IEnumerable<VehiculosMVC.Models.Vehiculo>

@{
    ViewData["Title"] = "Lista de Vehículos";
}

<h1>Lista de Vehículos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Vehículo</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Placa</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Año</th>
            <th>Tipo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Placa</td>
                <td>@item.Marca</td>
                <td>@item.Modelo</td>
                <td>@item.Año</td>
                <td>@item.Tipo</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Ver</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>