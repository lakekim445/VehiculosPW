@model VehiculosMVC.Models.Mantenimiento

@{
    ViewData["Title"] = "Detalle del Mantenimiento";
}

<h1>Detalle del Mantenimiento</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Vehículo</dt>
        <dd class="col-sm-10">@Model.Vehiculo?.Placa - @Model.Vehiculo?.Marca @Model.Vehiculo?.Modelo</dd>

        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.Fecha.ToShortDateString()</dd>

        <dt class="col-sm-2">Tipo Servicio</dt>
        <dd class="col-sm-10">@Model.TipoServicio</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Descripción</dd>

        <dt class="col-sm-2">Costo</dt>
        <dd class="col-sm-10">@Model.Costo.ToString("C")</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>